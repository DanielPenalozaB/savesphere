# Local development. Copy to .env (git-ignored): `cp .env.example .env`
# Production values live in Coolify, never in the repository.

# --- Database (matches infra/compose.dev.yml) ---
DATABASE_URL=postgres://savesphere:savesphere@localhost:5432/savesphere

# --- API ---
PORT=3000
# Public origin of the web app. The web server proxies /api/* to the API on the same origin.
APP_URL=http://localhost:5173
# openssl rand -hex 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# 32 random bytes, base64: openssl rand -base64 32
AI_KEYS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Brute-force protection on sign-in/sign-up.
AUTH_RATE_LIMIT=true

# --- Optional AI ---
# `fake` = deterministic responses, handy for UI work without a key. `real` = call providers.
AI_PROVIDER_MODE=fake
# Optional instance-wide key used when a user has not added their own.
INSTANCE_AI_PROVIDER=
INSTANCE_AI_KEY=

# --- Optional chat channels (a channel is offered only when configured) ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Web ---
API_INTERNAL_URL=http://localhost:3000
