{
	"name": "savesphere",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"check": "turbo check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "turbo test",
		"test:e2e": "pnpm --filter @savesphere/e2e e2e",
		"db:generate": "pnpm --filter @savesphere/db generate",
		"db:migrate": "turbo build --filter=@savesphere/db && pnpm --filter @savesphere/db migrate",
		"db:seed": "turbo build --filter=@savesphere/db && pnpm --filter @savesphere/db seed",
		"infra:up": "docker compose -f infra/compose.dev.yml up -d --wait",
		"infra:down": "docker compose -f infra/compose.dev.yml down",
		"db:studio": "pnpm --filter @savesphere/db studio",
		"bootstrap": "pnpm infra:up && pnpm db:migrate && pnpm db:seed"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.11.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1"
	},
	"type": "module"
}
