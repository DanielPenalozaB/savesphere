{
	"name": "@savesphere/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./seed": {
			"types": "./dist/seed.d.ts",
			"default": "./dist/seed.js"
		}
	},
	"files": [
		"dist",
		"migrations"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"check": "tsc --noEmit",
		"generate": "drizzle-kit generate",
		"migrate": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
		"seed": "node --env-file-if-exists=../../.env dist/cli/seed.js",
		"studio": "drizzle-kit studio",
		"lint": "eslint ."
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"typescript": "~6.0.3"
	}
}
