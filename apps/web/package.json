{
	"name": "@savesphere/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest run --project server",
		"test": "vitest run",
		"test:component": "vitest run --project client",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@iconify-json/material-symbols": "^1.2.97",
		"@inlang/paraglide-js": "^2.29.3",
		"@savesphere/contracts": "workspace:*",
		"@savesphere/core": "workspace:*",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
